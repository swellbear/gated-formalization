# Copy to .env in this folder and fill in. Do not commit .env.
# Get a key at https://the-odds-api.com/
THE_ODDS_API_KEY=
# ntfy phone alerts for `python -m golf_offshoot watch` and one optional
# completion ping from `python -m golf_offshoot shell` (success/failure only).
# If NTFY_TOPIC is empty, shell notify stays off. Watch still requires a topic.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
# Operator shell SoT roots. Unset = local dry-run dirs if present, else repo data/.
# GOLF_OFFSHOOT_ARTIFACT_ROOT=/workspace/golf_offshoot_real_exports
# GOLF_OFFSHOOT_SHADOW_PATH=/workspace/golf_offshoot_real_exports/shadow/advises.jsonl
# GOLF_OFFSHOOT_VIZ_ROOT=/workspace/illustrator_ops/golf_offshoot

